# Auto detect text files and perform LF normalization
* text=auto
# Unity serialized assets are text; media files are binary.
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.json text eol=lf
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
